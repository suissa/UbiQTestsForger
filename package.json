{
  "name": "@suissa/ubiq-tests-forger",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "generate": "node --experimental-strip-types src/cli.ts generate examples/2FA-passwordless",
